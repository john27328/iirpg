[Unit]
Description=IIRPG HTTPS access by public IP
Documentation=https://caddyserver.com/docs/
Wants=network-online.target
After=network-online.target

[Service]
Type=notify
User=iirpg-web
Group=iirpg-web
EnvironmentFile=/etc/iirpg-caddy/environment
Environment=XDG_CONFIG_HOME=/var/lib/iirpg-caddy/config
ExecStart=/usr/local/bin/iirpg-caddy run --config /etc/iirpg-caddy/Caddyfile --adapter caddyfile
ExecReload=/usr/local/bin/iirpg-caddy reload --config /etc/iirpg-caddy/Caddyfile --adapter caddyfile
StateDirectory=iirpg-caddy
StateDirectoryMode=0700
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
UMask=0077
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
